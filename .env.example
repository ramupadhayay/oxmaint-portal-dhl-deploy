# Copy to .env.local and fill in. .env.local is gitignored and never deployed
# by the script — it is written once on each machine.

# MongoDB connection string. Without it the portal still runs: the API answers
# persisted:false and every screen falls back to the seeded plant, but nothing
# anyone creates survives a reload.
MONGO_URI=

# Signs the admin console's cookie. Any long random string; the same value must
# be present wherever this app runs, or everyone signed in is signed out on
# deploy. Leaving it unset falls back to a value that is public in this repo.
JWT_SECRET=

# Optional. Defaults to 3006 — set it if that port is taken on the host.
# PORT=3006

# Shared with the iFactory console, which signs the ticket its Oxmaint card
# carries; app/api/admin/enter verifies it and opens /admin/portals without the
# sign-in form. Deliberately not JWT_SECRET: that one signs the admin cookies
# and never leaves this app, so rotating the shared one must not sign every
# live session out. Unset means the card lands on the ordinary sign-in.
IFACTORY_SSO_SECRET=

# The n8n instance behind the checklist generator. The HEPA portal's Create
# Checklist screen posts to $NEXT_PUBLIC_N8N_URL/webhook/generate_checklist —
# the base is set here, the path is in lib/generateChecklist.js.
#
# Unset means the screen composes a draft from the site's own procedures and
# says that is what it did, rather than claiming a model wrote it. That is a
# working state, not a broken one.
NEXT_PUBLIC_N8N_URL=

# Base64 of `user:password`, if that webhook wants Basic auth. Left out of the
# request entirely when unset. NEXT_PUBLIC_ reaches the browser, so whatever is
# put here is readable by anyone who loads the page — treat it as public.
NEXT_PUBLIC_OXMAINT_CHECKLIST_AI_AUTH=

# A complete URL, if the generator ever moves off n8n. Overrides the pair above.
NEXT_PUBLIC_OXMAINT_CHECKLIST_AI_URL=

# Who may open /internal — the staff usage screen.
#
# A comma-separated list of staff emails, and the whole of the authorisation:
# /internal has its own sign-in at /internal/login issuing its own cookie, and
# no role is consulted. An admin cookie does not open it. That is deliberate —
# a dozen accounts carry `role: admin` and one of them is also a WAGA portal
# login, so gating on the role would have let a client open a page analysing
# their own usage.
#
# The list is checked again on every request, so taking an address out of it
# ends the sessions already issued to that person.
#
# Left empty, /internal is closed to everybody. That is the intended failure —
# a screen about clients must not become readable because a variable was missed.
#
# The account itself still has to exist: scripts/create-internal-user.mjs.
INTERNAL_EMAILS=

# Which customer demo the CMMS portal loads. One of the files in
# components/industries/oxmaint/lib/packs (chiller, dhl-gse, hospitality,
# generic). Unset means chiller. Baked in at build time — NEXT_PUBLIC_ values
# are, so this is a build argument and not a runtime setting.
NEXT_PUBLIC_OXMAINT_PACK=

# Which demos this deployment actually serves, as pack keys, so the switcher
# can offer them rather than showing them greyed out. e.g. chiller,dhl-gse
NEXT_PUBLIC_OX_DEMOS_SERVED=

# Mount this build on a sub-path, so several demos can share one domain.
# e.g. BASE_PATH=/dhl serves the portal at /dhl/portal/oxmaint. Unset leaves
# the build at the root, which is what an existing deployment expects.
BASE_PATH=

# ── DHL CVG GSE voice demo (see VOICE-SETUP.md) ───────────────────────────
# Build the Superhub pack. Required for the voice tools to read CVG WOs.
# NEXT_PUBLIC_OXMAINT_PACK=dhl-gse
#
# xAI grok-voice realtime. Without it the call card still shows the number
# but /api/voice/xai/incoming returns 503.
XAI_API_KEY=
#
# Existing Trial Demo Support line. Unset still displays +1 (415) 639-4335.
VOICE_DEMO_PHONE_NUMBER=+14156394335
#
# Bearer for POST /api/mcp (required in production). Voice sends this on tool calls.
MCP_API_KEY=
# MCP_AUTH_REQUIRED=false
# MCP_SERVER_URL=
#
# Optional semantic lookup. Namespace for this pack is oxmaint-dhl-gse.
# Tools always have a deterministic in-memory fallback.
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=
# PINECONE_NAMESPACE=oxmaint-dhl-gse
#
# Optional telephony extras.
# TWILIO_AUTH_TOKEN=
# XAI_WEBHOOK_SECRET=
